<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>sibarum.concordance</groupId>
    <artifactId>concordance-indexer</artifactId>
    <version>0.1.2-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Concordance Indexer</name>
    <description>
        A source index for structural, logical and inductive queries over Java. The first artifact it builds from
        a Maven project is a receipt-graph: a control-logic graph whose cycles carry inductive hypotheses. The
        graph, the notary and the issuers are Cardinal's, and there is exactly one of each — Concordance is a
        second drafter for it, reading Java where Cardinal's own drafter reads Pontif IR.
    </description>

    <modules>
        <!-- What a Maven project is, as far as indexing is concerned: a reactor of modules, each with source
             roots holding .java files. Reads poms directly, because the shipped binary cannot assume Maven is
             installed on the machine it runs on. Depends on nothing. -->
        <module>concordance-project</module>
        <!-- The structural index: what is declared, where, and what refers to it. Answers the questions an
             editor asks (find usages, find implementations, find a name), which are about declarations and
             references rather than paths and equations, and so are a separate artifact from the receipt-graph. -->
        <module>concordance-index</module>
        <!-- Concordance from a terminal: the same index with an argv in front of it, so it can be demonstrated
             and scripted without a window. The native-image target. -->
        <module>concordance-cli</module>
        <!-- Java source to Cardinal receipt-graph: the node identity Java needs, the mapping from Java types onto
             Cardinal sorts, and the drafter that transcribes a method body into branches. -->
        <module>concordance-drafter</module>
    </modules>

    <properties>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Cardinal: the receipt-graph types, the notary, the issuers, and the symbolic vocabulary and reasoning
             underneath them. We own Cardinal, so a change Java needs is made there rather than worked around
             here. Installed to the local .m2 by `mvn install` in the sibling cardinal repo, the same arrangement
             vexelray has with supirvast. Note the version is 1.2-SNAPSHOT, not 0.1.0. -->
        <cardinal.version>1.2-SNAPSHOT</cardinal.version>
        <!-- JavaParser 3.28.2 parses Java 25 completely; we drive it at LanguageLevel.RAW so nothing reflects.
             See docs/javaparser-evaluation.md for why, and for why its symbol solver is test-scope only. -->
        <javaparser.version>3.28.2</javaparser.version>
        <!-- Vineflower 1.12.0 decompiles a library class for display when its jar has no sources. It never runs the
             code it reads, has no dependencies, and finds its plugins without ServiceLoader. Only display goes
             through it: what a class declares is read from the class file itself, by java.lang.classfile. -->
        <vineflower.version>1.12.0</vineflower.version>
        <!-- Intrabuf encodes a library file's manifest and its prebuilt index (see LibraryFile): generated codecs,
             nothing reflective, so it crosses native-image as the parser does. We own it, like Cardinal; the
             build is in the local .m2 from `mvn install` in the sibling intrabuf repo. Kept on the version the
             VexelRay automation stack uses: a consumer of both resolves one intrabuf-runtime, and codecs generated
             against another version fail at run time (NoSuchMethodError on MessageCodec). -->
        <intrabuf.version>0.1.2-SNAPSHOT</intrabuf.version>
        <junit.version>5.11.4</junit.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Reactor-internal modules: children reference these without a version. -->
            <dependency>
                <groupId>sibarum.concordance</groupId>
                <artifactId>concordance-project</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.concordance</groupId>
                <artifactId>concordance-index</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.concordance</groupId>
                <artifactId>concordance-drafter</artifactId>
                <version>${project.version}</version>
            </dependency>

            <dependency>
                <groupId>sibarum.cardinal</groupId>
                <artifactId>cardinal-receipts</artifactId>
                <version>${cardinal.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.javaparser</groupId>
                <artifactId>javaparser-core</artifactId>
                <version>${javaparser.version}</version>
            </dependency>
            <dependency>
                <groupId>sibarum.intrabuf</groupId>
                <artifactId>intrabuf-runtime</artifactId>
                <version>${intrabuf.version}</version>
            </dependency>
            <dependency>
                <groupId>org.vineflower</groupId>
                <artifactId>vineflower</artifactId>
                <version>${vineflower.version}</version>
            </dependency>
            <!-- Test scope only, and deliberately so: the symbol solver is a 99.5%-accurate oracle to
                 differential-test our own resolution against, and cannot cross native-image. -->
            <dependency>
                <groupId>com.github.javaparser</groupId>
                <artifactId>javaparser-symbol-solver-core</artifactId>
                <version>${javaparser.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- Platform-specific code only in -windows, -linux and -macos modules: vexelray-build's isolate goal fails
                 the build on any outside them (vexelray-build/README.md). -->
            <plugin>
                <groupId>dev.vexelray.build</groupId>
                <artifactId>vexelray-build-maven-plugin</artifactId>
                <version>0.1.2-SNAPSHOT</version>
                <executions>
                    <execution>
                        <id>isolate</id>
                        <goals>
                            <goal>isolate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
